--- /dev/null
+++ b/src/watch.rs
@@ -0,0 +1,72 @@
+use std::collections::BTreeMap;
+use std::io::{self, Read};
+use std::process::Command;
+use std::thread::sleep;
+use std::time::{Duration, Instant};
+
+const POLL: Duration = Duration::from_secs(15);
+const GIVE_UP: Duration = Duration::from_secs(50 * 60);
+
+fn tips(main: &str) -> io::Result<BTreeMap<String, String>> {
+    let out = Command::new("git")
+        .args(["for-each-ref", "--format=%(refname:short) %(objectname)", "refs/heads/"])
+        .output()?;
+    Ok(String::from_utf8_lossy(&out.stdout)
+        .lines()
+        .filter_map(|l| l.split_once(' '))
+        .filter(|(b, _)| *b == main || b.starts_with(&format!("{main}-")))
+        .map(|(b, sha)| (b.to_string(), sha.to_string()))
+        .collect())
+}
+
+fn status(ci: &str, sha: &str) -> io::Result<&'static str> {
+    let code = Command::new("sh").arg("-c").arg(ci.replace("{rev}", sha)).output()?.status.code();
+    Ok(match code {
+        Some(0) => "pass",
+        Some(2) => "pending",
+        _ => "fail",
+    })
+}
+
+/// A Stop hook for `asyncRewake`: while CI is pending on `main` or a `main-*` branch, waits for
+/// a run to finish and exits 2 with what finished, which wakes the idle session. Exits 0 when
+/// nothing is pending.
+pub fn watch(main: &str, ci: &str) -> io::Result<i32> {
+    io::stdin().read_to_end(&mut Vec::new())?;
+    let started = Instant::now();
+    let mut waiting: BTreeMap<String, String> = BTreeMap::new();
+    for (branch, sha) in tips(main)? {
+        if status(ci, &sha)? == "pending" {
+            waiting.insert(branch, sha);
+        }
+    }
+    while !waiting.is_empty() && started.elapsed() < GIVE_UP {
+        sleep(POLL);
+        let now = tips(main)?;
+        let mut finished = vec![];
+        for (branch, sha) in waiting.clone() {
+            if now.get(&branch) != Some(&sha) {
+                waiting.remove(&branch);
+                if let Some(new) = now.get(&branch) {
+                    waiting.insert(branch, new.clone());
+                }
+                continue;
+            }
+            let s = status(ci, &sha)?;
+            if s != "pending" {
+                waiting.remove(&branch);
+                finished.push(format!("{branch} {} {s}", &sha[..7]));
+            }
+        }
+        if !finished.is_empty() {
+            let rest: Vec<&str> = waiting.keys().map(String::as_str).collect();
+            eprintln!(
+                "CI finished: {}.{}",
+                finished.join(", "),
+                if rest.is_empty() { String::new() } else { format!(" Still pending: {}.", rest.join(", ")) }
+            );
+            return Ok(2);
+        }
+    }
+    Ok(0)
+}
